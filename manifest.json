{
  "manifest_version": 3,
  "name": "Ackless",
  "version": "0.1.0",
  "description": "Open-source browser extension that hides Australian Welcome to Country and Acknowledgement of Country blocks.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ackless",
    "default_popup": "src/popup.html"
  },
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.au/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ackless@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
